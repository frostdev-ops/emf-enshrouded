// emf_core.dll's version information (shown in Explorer's file properties).
#include <winres.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION EMF_VER_MAJOR, EMF_VER_MINOR, EMF_VER_PATCH, 0
 PRODUCTVERSION EMF_VER_MAJOR, EMF_VER_MINOR, EMF_VER_PATCH, 0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "EMF contributors"
            VALUE "FileDescription", "EMF core: the mod API, console and mod loading"
            VALUE "FileVersion", EMF_VERSION
            VALUE "InternalName", "emf_core"
            VALUE "LegalCopyright", "Copyright (c) 2026 EMF contributors. MIT licence."
            VALUE "OriginalFilename", "emf_core.dll"
            VALUE "ProductName", "EMF (Enshrouded Modding Framework)"
            VALUE "ProductVersion", EMF_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
