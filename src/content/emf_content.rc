// emf_content.dll's version information (shown in Explorer's file properties). CMake compiles it with EMF's version
// (EMF_VERSION, EMF_VER_*) and cargo links the result into the DLL (build.rs, EMF_CONTENT_RES). The DLL is built from
// EML and EMF's shim, so as a whole it is under the GPL-3.0-or-later (THIRD_PARTY_NOTICES.md).
#include <winres.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION EMF_VER_MAJOR, EMF_VER_MINOR, EMF_VER_PATCH, 0
 PRODUCTVERSION EMF_VER_MAJOR, EMF_VER_MINOR, EMF_VER_PATCH, 0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "EMF contributors"
            VALUE "FileDescription", "EMF content builder for EML mods"
            VALUE "FileVersion", EMF_VERSION
            VALUE "InternalName", "emf_content"
            VALUE "LegalCopyright", "Copyright (c) EML contributors and EMF contributors. GPL-3.0-or-later."
            VALUE "OriginalFilename", "emf_content.dll"
            VALUE "ProductName", "EMF (Enshrouded Modding Framework)"
            VALUE "ProductVersion", EMF_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
